resource_name = "export"
script/source = "extends Control

@export var display_text: String = \"Default Text\"

@onready var button_node = $Button
@export_enum(\"Danger\", \"LightButton\") var selected_theme_type: String

func _ready():
	button_node.theme_type_variation = selected_theme_type if selected_theme_type != null else \"\"
"

